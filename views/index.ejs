<h2 class="table-title">Lista cărți</h2>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Titlu</th>
                <th>Autor</th>
                <th>An</th>
                <th>Preț</th>
                <th>Adaugă în coș</th>
            </tr>
        </thead>
        <tbody>
            <% if (produse && produse.length > 0) { %>
                <% produse.forEach(p => { %>
                    <tr>
                        <td><%= p.titlu %></td>
                        <td><%= p.autor %></td>
                        <td><%= p.anAparitie %></td>
                        <td><%= p.pret %> lei</td>
                        <td>
                            <% if (utilizator) { %>
                                <a href="/adaugare-cos?id=<%= p.id %>"><button>Adaugă</button></a>
                            <% } else { %>
                                <button disabled>Login necesar</button>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="5" style="text-align:center;">Nu există produse în baza de date</td></tr>
            <% } %>
        </tbody>
    </table>
</div>