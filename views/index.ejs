<h2 class="table-title">Cărțile lunii</h2>

<div class="carti-grid">
    <% if (produse && produse.length > 0) { %>
        <% produse.forEach(p => { %>
            <div class="carte-card">
                <div class="carte-img-wrap">
                    <img src="/images/<%= p.imagine %>" alt="<%= p.titlu %>" class="carte-img">
                </div>
                <div class="carte-info">
                    <h3 class="carte-titlu"><%= p.titlu %></h3>
                    <p class="carte-autor"><%= p.autor %></p>
                    <p class="carte-an"><%= p.anAparitie %></p>
                    <p class="carte-pret"><%= p.pret %> lei</p>
                    <% if (utilizator) { %>
                        <a href="/adaugare-cos?id=<%= p.id %>">
                            <button class="btn-cos">+ Adaugă în coș</button>
                        </a>
                    <% } else { %>
                        <button disabled class="btn-cos">Login necesar</button>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <p style="text-align:center;">Nu există produse în baza de date.</p>
    <% } %>
</div>