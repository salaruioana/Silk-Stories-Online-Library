<div class="auth-card">
<h2>Autentificare</h2>

<% if (mesajEroare) { %>
    <p class="error-msg"><%= mesajEroare %></p>
<% } %>

<form action="/verificare-autentificare" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
        Utilizator:
        <input type="text" name="utilizator" autocomplete="off">
    </label>
    <label>
        Parola:
        <input type="password" name="parola" autocomplete="new-password">
    </label>

    <button type="submit">Autentificare</button>
</form>
</div>