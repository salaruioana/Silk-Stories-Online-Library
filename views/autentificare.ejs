<!DOCTYPE html>
<html>

<head>
    <title>Autentificare</title>
</head>

<body>

    <h1>Autentificare</h1>

    <% if(mesajEroare) { %>

        <p style="color:red;">
            <%= mesajEroare %>
        </p>

        <% } %>

            <form action="/verificare-autentificare" method="POST">

                <label>
                    Utilizator:
                    <input type="text" name="utilizator">
                </label>

                <br><br>

                <label>
                    Parola:
                    <input type="password" name="parola">
                </label>

                <br><br>

                <button type="submit">
                    Autentificare
                </button>

            </form>

</body>

</html>