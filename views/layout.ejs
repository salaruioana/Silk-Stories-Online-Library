<html>

<head>
    <title>Silk & Stories</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <div class="header-top">
            <img id="header-img" src="/images/books.png" alt="BookShop" class="header-img">
            <h1 class="site-title">Silk & Stories</h1>
        </div>

        <p>
            <% if (typeof utilizator !=='undefined' && utilizator) { %>
                Autentificat ca <strong>
                    <%= utilizator.prenume %>
                        <%= utilizator.nume %>
                </strong>
                <% } %>
        </p>

        <nav>
            <a href="/"><button>Acasă</button></a>
            <a href="/chestionar"><button>Chestionar</button></a>
            <a href="/vizualizare-cos"><button>Coș</button></a>
            <a href="/creare-bd"><button>Creare BD</button></a>
            <a href="/inserare-bd"><button>Încărcare BD</button></a>
            <a href="/stergere-bd"><button>Ștergere BD</button></a>
            <% if (typeof utilizator !=='undefined' && utilizator) { %>
                <a href="/logout"><button>Logout</button></a>
                <% } else { %>
                    <a href="/autentificare"><button>Autentificare</button></a>
                    <% } %>
            <% if (typeof utilizator !== 'undefined' && utilizator && utilizator.rol === 'ADMIN') { %>
                <a href="/admin"><button>Admin</button></a>
            <% } %>
        </nav>
    </header>

    <main>
        <%- body %>
    </main>

    <footer>
        <hr>
        <p>&copy; 2026 Ioana Șalaru. Toate drepturile rezervate.</p>
    </footer>

</body>

</html>